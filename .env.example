# Configuration reference only: copying this file is not a runnable local setup.
# Local: pnpm build:packages && node scripts/workspace-setup.mjs generates private
# .env and apps/web/.env.local with explicit loopback-only development auth.
# Production: supply required values via a secret manager; no local DB fallback.
DATABASE_URL=
APP_ORIGIN=
# Production uses Supabase, never development impersonation.
AUTH_MODE=supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Generate once, retain securely; random >=32 bytes, e.g. openssl rand -hex 32.
SESSION_SECRET=
# Exactly 32 random bytes encoded as base64: openssl rand -base64 32.
# Keep stable while encrypted connections exist; replacement is not key rotation.
CREDENTIAL_ENCRYPTION_KEY=
# Real provider requests remain disabled by application policy, not this file.
# Do not put provider API keys here: use the encrypted Connections workflow.
